      <aliases enabled='yes' />
      <column caption='Review Performance Score' datatype='integer' name='[Calculation_0308991237431299]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Number Of Reviews]*[Review Scores Rating]' />
      </column>
      <column caption='Category' datatype='string' name='[Calculation_0308991239520260]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt;=300 THEN &quot;Luxury&quot;&#13;&#10;ELSEIF [Price]&gt;=150 THEN &quot;Standard&quot;&#13;&#10;ELSE &quot;Budget&quot;&#13;&#10;END' />
      </column>
      <column caption='Review Category' datatype='string' name='[Calculation_0308991241687045]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Number Of Reviews] &gt;= 100 THEN &quot;Highly Reviewed&quot;&#13;&#10;ELSE &quot;Less Reviewed&quot;&#13;&#10;END' />
      </column>
      <column caption='Availability Status' datatype='string' name='[Calculation_0308991244345350]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Host Since] &lt;= TODAY() THEN &quot;Active Host&quot;&#13;&#10;ELSE &quot;New Host&quot;&#13;&#10;END' />
      </column>
      <column caption='Price Filter Category' datatype='string' name='[Calculation_0308991248343049]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt; [Parameters].[Parameter 0308991246217224]&#13;&#10;THEN &quot;Above Limit&quot;&#13;&#10;ELSE &quot;Below Limit&quot;&#13;&#10;END' />
      </column>
      <column caption='Host_Since' datatype='datetime' name='[Calculation_2056665671471106]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL([Host Since],DATE(&quot;01-01-2010&quot;))' />
      </column>
      <column caption='Updated_Neighbourhood' datatype='string' name='[Calculation_2056665672286212]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([Neighbourhood ],&quot;Unknown&quot;)' />
      </column>
      <column caption='Review Score Rating (bin)' datatype='string' name='[Calculation_2056665672720389]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL(STR([Review Scores Rating (bin)]),&quot;Not Rated&quot;)' />
      </column>
      <column caption='Updated_Beds' datatype='integer' name='[Calculation_2056665673404422]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Beds],0)' />
      </column>
      <column datatype='integer' name='[Host Id]' role='dimension' type='ordinal' />
      <column datatype='datetime' hidden='true' name='[Host Since]' role='dimension' type='ordinal' />
      <column caption='Neighbourhood1' datatype='string' name='[Neighbourhood ]' role='dimension' type='nominal' />
      <column datatype='string' hidden='true' name='[Neighbourhood]' role='dimension' type='nominal' />
      <column caption='Property Type1' datatype='string' name='[Property Type]' role='dimension' type='nominal' />
      <column datatype='integer' hidden='true' name='[Review Scores Rating (bin)]' role='measure' type='quantitative' />
      <column datatype='string' name='[Room Type (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[Room Type]' new-bin='true'>
          <bin default-name='false' value='&quot;Budget Stay&quot;'>
            <value>&quot;Private room&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Premium Stay&quot;'>
            <value>&quot;Entire home/apt&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Shared Accomadation&quot;'>
            <value>&quot;Shared room&quot;</value>
          </bin>
        </calculation>
      </column>
      <column datatype='string' name='[Room Type]' role='dimension' type='nominal' />
      <column aggregation='Sum' datatype='integer' default-format='*00000' name='[Zipcode]' role='dimension' semantic-role='[ZipCode].[Name]' type='ordinal' />
      <column caption='Airbnb_listings.csv' datatype='table' name='[__tableau_internal_object_id__].[Airbnb_listings.csv_1BE2088A10014920A96DB09C28ED9BCC]' role='measure' type='quantitative' />
      <group caption='Property Type1 Set' name='[Property Type1 Set]' name-style='unqualified' user:ui-builder='filter-group'>
        <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
          <groupfilter function='member' level='[Property Type]' member='&quot;Apartment&quot;' />
